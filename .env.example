# Yerel gelistirme icin: bu dosyayi .env olarak kopyalayip degerleri doldur.
# AWS EC2 uzerinde: scripts/env-from-aws.sh calistir, .env otomatik uretilir.
POSTGRES_DB=
POSTGRES_USER=
DB_CONNECTION_STRING=
FASTAPI_URL=
# Virgülle ayrılmış izinli origin listesi. Boş bırakılırsa http://localhost,https://localhost kullanılır.
ALLOWED_ORIGINS=